{
  "name": "hermes-iroh-app",
  "version": "0.8.2",
  "description": "Desktop client for the Hermes Agent Iroh-channel plugin",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Hermes Iroh App Contributors",
    "email": "noreply@example.com"
  },
  "homepage": "https://example.com/hermes-iroh-app",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "package": "node scripts/package.mjs",
    "tauri": "tauri",
    "tauri:sync": "node scripts/tauri-version.mjs sync",
    "tauri:check": "node scripts/tauri-version.mjs check",
    "release:collect": "node scripts/collect-release-assets.mjs",
    "release:size": "node scripts/check-installer-size.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "highlight.js": "^11.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=26.13.1"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
