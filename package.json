{
  "name": "hermes-iroh-app",
  "version": "0.4.1",
  "description": "Desktop client for the Hermes Agent Iroh-channel plugin",
  "main": "./out/main/index.js",
  "license": "MIT",
  "author": {
    "name": "Hermes Iroh App Contributors",
    "email": "noreply@example.com"
  },
  "homepage": "https://example.com/hermes-iroh-app",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "package": "npm run build && electron-builder"
  },
  "dependencies": {
    "@number0/iroh": "1.2.0",
    "highlight.js": "^11.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "allowScripts": {
    "electron@45.4.1": true,
    "electron-winstaller@5.4.0": true,
    "fsevents@2.3.3": true
  }
