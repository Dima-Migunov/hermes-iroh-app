# Dependencies
node_modules/

# Build output: Vite renderer and Tauri bundles
out/
dist/
/release/
src-tauri/target/
src-tauri/gen/

# TypeScript / Vite caches
*.tsbuildinfo
.vite/

# Test artifacts
coverage/
.vitest/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment files (never commit secrets)
.env
.env.*
!.env.example

# Local runtime data (Iroh keys, session history, config)
# The app stores these outside the repo; these patterns catch stray copies
# created during manual testing.
client.key
server.key
*.iroh-key
# Deterministic, test-only key used by the legacy compatibility fixture.
!src-tauri/tests/fixtures/legacy-data/client.key

# OS / editor cruft
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
.idea/
.vscode/
*.swp
*.swo

# Container build caches
.cache/
